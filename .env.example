# ===============================================
# STT KYUTAI - ENVIRONMENT CONFIGURATION
# ===============================================
# Copy this file to .env and customize for your setup
# Usage: cp .env.example .env

# -----------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------

# Server host address (0.0.0.0 allows external connections)
SERVER_HOST=0.0.0.0

# Server port
SERVER_PORT=8000

# Maximum concurrent WebSocket connections
MAX_CONNECTIONS=100

# Skip model load at startup (1 = skip, 0 = load)
KYUTAI_SKIP_MODEL_LOAD=0

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# -----------------------------------------------
# MODEL CONFIGURATION
# -----------------------------------------------

# HuggingFace model ID
# Options:
#   - kyutai/stt-1b-en_fr-trfs (1B params, English/French)
#   - kyutai/stt-2.6b-en-trfs (2.6B params, English only)
MODEL_ID=kyutai/stt-1b-en_fr-trfs

# Device for inference (cpu, cuda, mps)
DEVICE=cpu

# Model data type (float32, float16, bfloat16)
# float16 recommended for CPU, float32 for GPU
DTYPE=float16

# Enable torch.compile for optimization (true/false)
# Speeds up inference after initial warmup
ENABLE_COMPILE=true

# -----------------------------------------------
# PERFORMANCE SETTINGS
# -----------------------------------------------

# LRU cache size for transcription results
# Higher values = more memory usage but faster repeated queries
CACHE_SIZE=1000

# Maximum audio file size in MB
MAX_AUDIO_SIZE_MB=10

# WebSocket timeout in seconds
WS_TIMEOUT=300

# Number of worker threads
WORKERS=1

# Enable GPU memory optimization (for CUDA)
# TORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

# -----------------------------------------------
# AUDIO PROCESSING
# -----------------------------------------------

# Target sample rate in Hz (Kyutai models use 24000)
TARGET_SAMPLE_RATE=24000

# Enable audio normalization (true/false)
ENABLE_NORMALIZATION=true

# Enable Voice Activity Detection (true/false)
# VAD can improve accuracy by filtering silence
ENABLE_VAD=false

# VAD aggressiveness level (0-3, higher = more aggressive)
VAD_AGGRESSIVENESS=2

# Minimum speech duration in seconds
MIN_SPEECH_DURATION=0.5

# Maximum speech duration in seconds (for streaming)
MAX_SPEECH_DURATION=30.0

# -----------------------------------------------
# ADVANCED SETTINGS
# -----------------------------------------------

# Enable model quantization (true/false)
# Reduces memory usage but may affect quality
ENABLE_QUANTIZATION=false

# Quantization bits (4, 8)
QUANTIZATION_BITS=8

# Enable attention slicing (for low-memory GPUs)
ENABLE_ATTENTION_SLICING=false

# Batch size for processing
BATCH_SIZE=1

# Enable gradient checkpointing (saves memory)
ENABLE_GRADIENT_CHECKPOINTING=false

# -----------------------------------------------
# CORS SETTINGS
# -----------------------------------------------

# CORS allowed origins (comma-separated)
# Use "*" to allow all origins (not recommended for production)
CORS_ORIGINS=*

# CORS allow credentials (true/false)
CORS_ALLOW_CREDENTIALS=true

# CORS allowed methods (comma-separated)
CORS_METHODS=GET,POST,OPTIONS

# CORS allowed headers (comma-separated)
CORS_HEADERS=*

# -----------------------------------------------
# MONITORING & DEBUGGING
# -----------------------------------------------

# Enable performance metrics collection (true/false)
ENABLE_METRICS=true

# Enable debug mode (true/false)
# Provides verbose logging and stack traces
DEBUG=false

# Enable profiling (true/false)
# WARNING: Significant performance impact
ENABLE_PROFILING=false

# -----------------------------------------------
# MODEL CACHE SETTINGS
# -----------------------------------------------

# HuggingFace cache directory
# Default: ~/.cache/huggingface
# HF_HOME=/path/to/custom/cache

# Transformers cache directory
# TRANSFORMERS_CACHE=/path/to/custom/cache

# Disable HuggingFace telemetry (true/false)
HF_HUB_OFFLINE=false

# -----------------------------------------------
# NOTES
# -----------------------------------------------
# 
# Model Selection:
# - stt-1b-en_fr-trfs: Best for multilingual (English/French), smaller size
# - stt-2.6b-en-trfs: Best accuracy for English only, larger size
#
# Device Selection:
# - cpu: Works everywhere, slower inference
# - cuda: NVIDIA GPU, fastest inference (requires CUDA toolkit)
# - mps: Apple Silicon GPU (experimental)
#
# Memory Requirements:
# - stt-1b model: ~4-6GB RAM (CPU) or ~2-3GB VRAM (GPU)
# - stt-2.6b model: ~10-12GB RAM (CPU) or ~5-6GB VRAM (GPU)
#
# Performance Tips:
# 1. Use GPU (DEVICE=cuda) for 2-3x speedup
# 2. Enable torch.compile (ENABLE_COMPILE=true) for optimization
# 3. Increase CACHE_SIZE for repeated audio
# 4. Use float16 (DTYPE=float16) for CPU inference
# 5. Disable VAD if not needed (ENABLE_VAD=false)
#
# For more information, see README.md
